# Dev defaults for docker compose. Override any value in a local ".env" file.
# DEBUG=True makes settings load local.py (ALLOWED_HOSTS=*, console email).
DEBUG=True
ENABLE_LOGGING=False
LOG_LEVEL=DEBUG

# Leave empty: the entrypoint generates and persists one in the "appdata" volume
DJANGO_SECRET_KEY=

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=db

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# Host -> urlconf. Add the VPS IP / domain here if you access it that way.
UNGLEICH_SITE_CONFIGS={"ungleich.ch":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"blog.ungleich.ch":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"comic.ungleich.ch":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"digitalglarus.ch":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"datacenterlight.ch":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"rails-hosting.ch":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"django-hosting.ch":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"node-hosting.ch":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"devuanhosting.ch":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"devuanhosting.com":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"ipv6onlyhosting.com":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"digitalezukunft.ch":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"hack4glarus.ch":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"xn--nglarus-n2a.ch":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"localhost:8000":{"MULTISITE_CMS_URL":"dynamicweb.urls"},"127.0.0.1:8000":{"MULTISITE_CMS_URL":"dynamicweb.urls"}}
UNGLEICH_BLOG_SITE_ID=1
MULTISITE_CMS_FALLBACK=

EMAIL_HOST=localhost
DCL_ERROR_EMAILS_TO=dev@example.com
ADMIN_EMAIL=dev@example.com
DCL_SUPPORT_FROM_ADDRESS=dev@example.com
WEBHOOK_SECRET=dev
RECAPTCHA_PUBLIC_KEY=dev
RECAPTCHA_PRIVATE_KEY=dev
STRIPE_API_PRIVATE_KEY=
STRIPE_API_PUBLIC_KEY=
STRIPE_API_PRIVATE_KEY_TEST=

# Values the settings require; the app has no defaults for them
LDAP_CUSTOMER_GROUP_ID=0
LDAP_DEFAULT_START_UID=10000
PRE_EU_VAT_RATE=0
VM_BASE_PRICE=0

# OpenNebula / LDAP are not available in the test env
OPENNEBULA_USERNAME=oneadmin
OPENNEBULA_PASSWORD=opennebula
OPENNEBULA_PROTOCOL=http
# "test_domain" skips the import-time VMTemplate query (tables do not exist before migrate)
OPENNEBULA_DOMAIN=test_domain
OPENNEBULA_PORT=2633
OPENNEBULA_ENDPOINT=/RPC2

# Create sample pages/users on start, only into a database without page content
# (idempotent). Set to False to turn off;
# remove existing dummy data with: docker compose exec web python manage.py seed_dummy_data --purge
SEED_DUMMY_DATA=True
# Fixed dev login: dummy-admin@example.com / this password
DUMMY_ADMIN_PASSWORD=dummy-admin
# Integer settings (silence "failed to get env value" log lines)
EMAIL_PORT=25
CELERY_MAX_RETRIES=5
FIRST_VM_ID_AFTER_EU_VAT=0
MAX_TIME_TO_WAIT_FOR_VM_TERMINATE=15
